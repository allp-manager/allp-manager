class Allp < Formula
  desc "Transparent orchestrator for native package managers"
  homepage "https://github.com/allp-manager/allp-manager"
  url "https://github.com/allp-manager/allp-manager/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"
  depends_on "rust" => :build

  def install
    ENV["ALLP_BUILD_CHANNEL"] = "stable"
    ENV["ALLP_BUILD_REVISION"] = "0"
    ENV["ALLP_BUILD_OFFICIAL"] = "0"
    system "cargo", "install", *std_cargo_args
  end

  test do
    assert_match "allp @VERSION@", shell_output("#{bin}/allp --version")
    assert_match "profile", shell_output("#{bin}/allp --help")
  end
end
